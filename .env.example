# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Telegram (уведомления о заявках) ───────────────────────────
# Токен бота от @BotFather. Chat ID надёжнее числовой: узнать через @userinfobot
# (личный чат: 123456789, группа: -100123456789). @username работает только
# для публичных каналов/групп — для личных чатов НЕ подходит.
TELEGRAM_BOT_TOKEN=9231450262:AAEo0ubu41ArUDxD9fiUzNpJEcqwYdCN4CI
TELEGRAM_CHAT_ID=@gorodamirabot

# ── Сайт ───────────────────────────────────────────────────────
SITE_URL=                 # Публичный адрес сайта, напр. https://goroda-mira.ru
                          # (каноникал, sitemap, ссылки в Telegram и iCal).
                          # Если пусто — берётся origin текущего запроса.
ADMIN_PROPERTY_URL_TEMPLATE=https://goroda-mira.ru/admin/cottages/{id}/calendar
                          # Шаблон ссылки «Открыть в админке» в уведомлении.
